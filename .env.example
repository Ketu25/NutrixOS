# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- AI copilot -------------------------------------------------------------
# Without this the app runs on the mock copilot: fully usable, deterministic,
# no network. With it, meal parsing, photo estimation, and coaching go live.
# Server-side only — this is never exposed to the browser.
ANTHROPIC_API_KEY=

# --- Supabase ---------------------------------------------------------------
# From your project's API settings. The publishable key is safe in the browser;
# row level security is what protects the data, and it is enabled on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Bypasses row level security entirely — never prefix this
# with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SECRET_KEY=
